# ---- Database ----
DATABASE_URL=postgresql://skillverify:skillverify@localhost:5432/skillverify?schema=public

# ---- Redis (cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Meilisearch ----
MEILI_HOST=http://localhost:7700
MEILI_KEY=masterKeyChangeMe

# ---- Object Storage (MinIO locally, R2 in prod) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skillverify
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_PUBLIC_URL=http://localhost:9000/skillverify

# ---- Auth / JWT ----
JWT_SECRET=replace-with-64-char-random-string
ENCRYPTION_KEY=replace-with-32-char-random-string
NEXTAUTH_SECRET=replace-with-32-char-random-string
NEXTAUTH_URL=http://localhost:3000

# ---- OAuth providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- AI (OpenRouter, free models) ----
OPENROUTER_API_KEY=
# Free models rotate in/out of upstream rate limits. Fallbacks kick in on 429/402.
OPENROUTER_RESUME_MODEL=openai/gpt-oss-120b:free
OPENROUTER_RESUME_FALLBACKS=deepseek/deepseek-v4-flash:free,nvidia/nemotron-3-super-120b-a12b:free,nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_FEEDBACK_MODEL=openai/gpt-oss-20b:free
OPENROUTER_FEEDBACK_FALLBACKS=qwen/qwen3-coder:free,openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free
# Optional — shows your app in OpenRouter's leaderboards
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=SkillVerify

# ---- Code execution sandbox ----
JUDGE0_URL=http://localhost:2358
JUDGE0_KEY=

# ---- Email ----
RESEND_API_KEY=

# ---- API URLs ----
API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
