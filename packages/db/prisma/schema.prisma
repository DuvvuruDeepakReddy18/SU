// SkillVerify — Prisma schema
// Multi-role model included up-front so we don't need to migrate later.
// Only STUDENT-facing endpoints are wired up in Phase 1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  STUDENT
  RECRUITER
  INSTITUTION_ADMIN
  INTERVIEWER
  PLATFORM_ADMIN
}

enum VerificationLayer {
  L0_UNVERIFIED
  L1_ACADEMIC
  L2_CERTIFIED
  L3_PROVEN
  L4_EXPERT
}

// How an L4 badge was earned — AI screening alone vs a human expert panel. Lets
// the credential badge show "AI-Verified L4" vs "Expert-Verified L4" so
// recruiters can calibrate trust per skill. Null until a skill reaches L4.
enum L4VerificationMethod {
  AI_VERIFIED
  EXPERT_VERIFIED
}

enum CertificationTier {
  TIER_1
  TIER_2
  TIER_3
  UNRANKED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole  @default(STUDENT)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft-delete tombstone. When set, the user is treated as gone by every
  // query path (login, profile, community, leaderboard, search). Their owned
  // rows (comments, applications, posts) stay so threads don't break, but
  // their display name/email is anonymized on deletion. Hard-delete remains
  // available as an admin-only path for GDPR erasure if ever needed.
  deletedAt     DateTime?

  studentProfile        StudentProfile?
  userSkills            UserSkill[]
  certifications        Certification[]
  projects              Project[]
  academicRecords       AcademicRecord[]
  externalIntegrations  ExternalIntegration[]
  submissions           Submission[]
  communityPosts        CommunityPost[]
  notifications         Notification[]
  votes                 CommunityVote[]
  communityComments     CommunityComment[]
  sentMessages          DirectMessage[]    @relation("SentMessages")
  receivedMessages      DirectMessage[]    @relation("ReceivedMessages")
  verificationAudits    VerificationAudit[]
  interviewBookings     InterviewBooking[] @relation("StudentBookings")
  conductedInterviews   InterviewBooking[] @relation("ConductedInterviews")
  panelistInterviews    InterviewBooking[] @relation("PanelistInterviews")
  interviewerPayouts    InterviewerPayout[] @relation("InterviewerPayouts")
  interviewerProfile    InterviewerProfile?
  aiScreenAttempts      AiScreenAttempt[]
  postedDrives          PlacementDrive[] @relation("PostedDrives")
  placementApplications PlacementApplication[]
  postedCompetitions    Competition[]    @relation("PostedCompetitions")
  competitionEntries    CompetitionEntry[]
  judgedScores          RoundScore[]       @relation("JudgedScores")
  judgePanels           CompetitionJudge[] @relation("JudgePanels")
  providedServices         FreelanceService[]  @relation("ProvidedServices")
  freelanceInquiriesAsClient   FreelanceInquiry[] @relation("FreelanceInquiriesAsClient")
  freelanceInquiriesAsProvider FreelanceInquiry[] @relation("FreelanceInquiriesAsProvider")
  freelanceMessages        FreelanceMessage[]
  // Company / recruiter portal
  createdEmployers         Employer[]         @relation("CreatedEmployers")
  recruiterProfile         RecruiterProfile?
  recruiterInquiriesSent   RecruiterInquiry[] @relation("RecruiterInquiriesAsRecruiter")
  recruiterInquiriesReceived RecruiterInquiry[] @relation("RecruiterInquiriesAsStudent")
  savedCandidates          SavedCandidate[]   @relation("SavedByRecruiter")
  savedAsCandidate         SavedCandidate[]   @relation("SavedAsCandidate")
  institutionAdminProfile  InstitutionAdminProfile?
  authTokens               AuthToken[]

  @@index([institutionId])
}

// Single-use, hashed tokens for email verification + password reset. The raw
// token is emailed; only its SHA-256 hash is stored, so a DB leak can't be
// used to verify or reset accounts.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "email_verify" | "password_reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Institution {
  id            String  @id @default(cuid())
  name          String
  // Optional + unique-when-present: some institutions (small DU colleges, etc.)
  // don't have their own email domain. Signup falls back to a chosen
  // institution id from the picker instead of email-derived matching.
  domain        String? @unique
  shortName     String?  // "IIT-D", "SRCC", "IIM-A"
  category      String?  // "engineering" | "management" | "law" | "science" | "commerce" | "arts" | "medical" | "other"
  nirfRank      Int?
  state         String?
  city          String?
  // Curated rows start verified=true. User-suggested rows from the signup
  // picker land here as verified=false and surface in the admin queue.
  verified      Boolean @default(true)
  addedByUserId String?
  tier          String?
  licenseStatus String  @default("trial")
  users         User[]
  admins        InstitutionAdminProfile[]
  competitions  Competition[]
  knowledge     InstitutionKnowledge[]
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([nirfRank])
  @@index([name])
}

// Knowledge base for the institution Q&A chatbot. Each row is a fact/snippet
// about a specific college (admissions, fees, facilities, contacts, …). The
// chatbot answers ONLY from these rows for college-specific questions, so it
// can't hallucinate. Populated by admins/TPOs per institution.
model InstitutionKnowledge {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  title         String
  content       String
  source        String?
  createdAt     DateTime    @default(now())

  @@index([institutionId])
}

model StudentProfile {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  // Legal name as it appears on the college ID. Used for verification
  // matching; may differ from fullName (preferred name shown in UI).
  governmentName String?
  // E.164-format phone number captured at signup ("+91XXXXXXXXXX").
  phoneNumber    String?
  // Distinct from User.email (which is the login email — can be Gmail/etc).
  // This is the @college.edu address used for institutional correspondence.
  instituteEmail String?
  // e.g. "B.Tech", "MBA", "BCA", "MBBS" — drives the # of semester tiles
  // on the verification page.
  courseProgram  String?
  headline       String?
  bio            String?
  avatarUrl      String?
  resumeUrl      String?
  // Free-text CGPA — shown alongside an UNVERIFIED badge until backed by
  // at least one verified AcademicRecord (see cgpaVerifiedAt).
  cgpa           Float?
  cgpaVerifiedAt DateTime?
  graduationYear Int?
  sharableSlug   String  @unique
  phone          String?
  location       String?
  geoLat         Float?
  geoLng         Float?
  // Social / profile links — extracted by the resume parser when present.
  linkedinUrl    String?
  githubUrl      String?
  leetcodeUrl    String?
  codechefUrl    String?
  portfolioUrl   String?
  // Institutional verification artefact (College ID card upload).
  collegeIdUrl              String?
  collegeIdUploadedAt       DateTime?
  collegeIdVerifiedAt       DateTime?
  // "pending_review" | "verified" | "rejected" | null (no ID uploaded yet)
  collegeIdStatus               String?
  collegeIdRejectionReason      String?
  // Structured rejection reason from REJECTION_REASONS enum. Free-text
  // `collegeIdRejectionReason` field above stays as an optional human note.
  collegeIdRejectionReasonCode  String?
  // Snapshot of what the OCR pre-screen extracted, for the admin queue.
  collegeIdOcrExtracted     Json?
  // User-defined "custom" links beyond the built-in social ones.
  // Shape: [{ label: string, url: string, icon?: string }]
  customLinks    Json?
  isPublic       Boolean @default(true)
  // Public-portfolio customization. Controls the rendered theme and the
  // order of sections on /u/[slug]. Defaults give the existing layout.
  shareTheme        String   @default("default") // "default" | "midnight" | "minimal"
  shareSectionsOrder String[] @default(["about", "skills", "projects", "certifications"])
  // Onboarding wizard progress. 0 = not started, 1 = ID uploaded, 2 = skill
  // added, 3 = first AC, 4 = done. Wizard auto-dismisses when this hits 4.
  onboardingStep Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model SkillCatalog {
  id             String          @id @default(cuid())
  name           String          @unique
  category       String
  parentSkillId  String?
  parent         SkillCatalog?   @relation("Children", fields: [parentSkillId], references: [id])
  children       SkillCatalog[]  @relation("Children")
  userSkills     UserSkill[]
  certifications Certification[]
  tierRules      CertificationTierRule[]

  @@index([category])
}

model UserSkill {
  id                       String            @id @default(cuid())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId                  String
  skill                    SkillCatalog      @relation(fields: [skillId], references: [id])
  selfRatedLevel           Int               @default(1)
  highestVerificationLayer VerificationLayer @default(L0_UNVERIFIED)
  l4VerificationMethod     L4VerificationMethod?
  createdAt                DateTime          @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Certification {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId            String?
  skill              SkillCatalog?     @relation(fields: [skillId], references: [id])
  issuer             String
  courseName         String
  issuedAt           DateTime?
  certificateUrl     String?
  verificationUrl    String?
  tier               CertificationTier @default(UNRANKED)
  verificationStatus String            @default("pending")
  createdAt          DateTime          @default(now())

  @@index([userId])
}

model CertificationTierRule {
  id         String            @id @default(cuid())
  issuer     String
  courseName String
  skillId    String?
  skill      SkillCatalog?     @relation(fields: [skillId], references: [id])
  tier       CertificationTier

  @@unique([issuer, courseName])
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String   // "github" | "manual"
  title        String
  description  String?
  repoUrl      String?
  liveUrl      String?
  techStack    String[]
  stars        Int      @default(0)
  lastCommitAt DateTime?
  linkedSkills String[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

model AcademicRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    Int
  cgpa        Float
  sgpa        Float?
  docUrl      String?
  // OCR-extracted from the uploaded marksheet. Used to display "verified by
  // <name>" and to support audits.
  extractedName        String?
  extractedInstitution String?
  examDate             DateTime?
  // SHA-256 of the uploaded file — used to reject exact-duplicate marksheets
  // (same student reuploading; different students submitting the same image).
  fileSha256           String?
  // "pending" | "verified" | "rejected"
  verificationStatus   String   @default("pending")
  // Raw OCR output for the admin queue / audit log.
  ocrExtracted         Json?
  rejectionReason      String?
  // Structured rejection reason from REJECTION_REASONS enum.
  rejectionReasonCode  String?
  verifiedVia String    // "digilocker" | "institution" | "manual" | "ai_ocr"
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([fileSha256])
}

model ExternalIntegration {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String   // "github" | "linkedin" | "leetcode" | "coursera"
  providerUserId        String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  lastSyncedAt          DateTime?
  syncStatus            String   @default("idle")
  createdAt             DateTime @default(now())

  @@unique([userId, provider])
}

model Problem {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  difficulty   String           // "easy" | "medium" | "hard"
  topics       String[]
  description  String
  constraints  String?
  examplesJson Json
  starterCode  Json?            // { python, javascript, cpp, java }
  points       Int              @default(10)
  // Question type. "code" = run-and-judge (default). "mcq" = case-study /
  // multiple-choice (Law, Commerce, …) graded by matching correctOption.
  kind          String          @default("code")
  options       String[]        // MCQ choices; empty for code problems
  correctOption Int?            // index into options; null for code problems
  explanation   String?         // shown after answering an MCQ
  testCases    TestCase[]
  submissions  Submission[]
  domains      PracticeDomain[] @relation("DomainProblems")
  createdAt    DateTime         @default(now())
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  output    String
  isHidden  Boolean @default(true)
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  language    String
  code        String
  verdict     String   // "AC" | "WA" | "TLE" | "RE" | "CE" | "PENDING"
  runtimeMs   Int?
  memoryKb    Int?
  aiFeedback  Json?
  // For non-AC verdicts we capture the first failing test case + its diff so
  // the student can see what their code actually printed vs what was expected.
  failedTest  Json?   // { input, expectedOutput, gotStdout, stderr, compileOutput }
  testsPassed Int?
  testsTotal  Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([problemId])
}

model CommunityPost {
  id          String             @id @default(cuid())
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAnonymous Boolean            @default(false)
  // Optional title — Reddit-style. Null means it's a quick microblog post.
  title       String?
  body        String
  tags        String[]
  // Sub-community slug — "general" | "internships" | "placements" | "freelance"
  // | "academic" | "rant" | "ama" | etc. Free-form but UI suggests defaults.
  subreddit   String             @default("general")
  visibility  String             @default("public") // "public" | "college_only"
  upvotes     Int                @default(0)
  downvotes   Int                @default(0)
  // "Score" = upvotes - downvotes. Maintained transactionally on vote
  // toggles so sort=top/hot doesn't need a heavy aggregate query.
  score       Int                @default(0)
  commentsCount Int              @default(0)
  // Moderator soft-delete. The post stays in the DB for audit, but the
  // body is replaced with "[removed]" in the UI.
  hiddenByMod Boolean            @default(false)
  createdAt   DateTime           @default(now())
  votes       CommunityVote[]
  comments    CommunityComment[]

  @@index([createdAt])
  @@index([subreddit, score])
  @@index([score])
}

// Renamed conceptually to "like" but model kept as CommunityVote for back-compat.
// value is now always 1 (we removed downvotes from the UI).
model CommunityVote {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int           // 1 (like) — old data may have -1, ignored by new UI
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model CommunityComment {
  id          String        @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAnonymous Boolean       @default(false)
  body        String
  // Threading: a null parent means top-level. Self-relation explicitly
  // names the back-relation so Prisma stops being ambiguous.
  parentCommentId String?
  parent          CommunityComment?  @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         CommunityComment[] @relation("Replies")
  // Moderator soft-delete (same idea as posts).
  hiddenByMod Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([parentCommentId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  userId     String
  scope      String   // "global" | "college:<id>" | "skill:<id>"
  score      Int
  rank       Int
  computedAt DateTime @default(now())

  @@index([scope, rank])
  @@index([userId, scope])
}

// ---------- Practice domains (Algorithms, Python, SQL, ...) ----------
model PracticeDomain {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?   // lucide icon name
  sortOrder   Int       @default(0)
  problems    Problem[] @relation("DomainProblems")
}

// Optional domain link on Problem (added without breaking existing relations).
// Defined via the relation above; Problem's side is a many-to-many through
// implicit table, since one problem can belong to multiple domains
// (e.g. Two Sum → Algorithms + Data Structures + Python).

// ---------- L4 Expert Interview bookings ----------
model InterviewBooking {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("StudentBookings", fields: [userId], references: [id], onDelete: Cascade)
  // Interviewer who claimed + conducted this booking (shared pool). Null while
  // the booking is still in the open queue.
  interviewerId String?
  interviewer   User?  @relation("ConductedInterviews", fields: [interviewerId], references: [id], onDelete: SetNull)
  skillId     String?
  scheduledAt DateTime
  // Lifecycle: "booked" → "completed_pending_review" → "released_pass" |
  // "released_fail"; or "cancelled" | "no_show". (Legacy rows may hold
  // "scheduled" | "passed" | "failed".)
  status      String   @default("booked")
  notes       String?
  panelNotes  String?
  // Overall interviewer score (0–100), set when scored.
  score       Int?
  result      String?  // "L4_VERIFIED" | "FEEDBACK_ONLY"
  meetingUrl  String?  // auto-generated Jitsi room URL
  // Daily-slot model (Ch.6). Null for legacy free-time bookings.
  slotId      String?
  slot        InterviewSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  // Panel of up to 2. interviewerId above is panelist 1; panelist2 is paired
  // randomly + independently at confirmation (anti-collusion, Ch.6). Null for
  // single-panel skills / legacy bookings.
  panelist2Id String?
  panelist2   User?    @relation("PanelistInterviews", fields: [panelist2Id], references: [id], onDelete: SetNull)
  // Delayed result release (~48h audit window, Ch.6) — set when results go live.
  reviewReleasedAt DateTime?
  // Recording + transcript (retained, access-controlled). Pipeline gated.
  recordingUrl String?
  transcript   String?
  // Student's choice whether this attempt is public on their portfolio (Ch.6).
  // Recruiters always see the last 2 attempts regardless (a query-level rule).
  publicVisibility Boolean @default(false)
  // Configurable fee line items (Ch.12): base + GST stored separately so rates
  // can change without a rewrite. amountInrPaise stays the charged total.
  baseAmountPaise   Int?
  gstAmountPaise     Int?
  // Razorpay payment fields — null when the platform is in free-beta mode.
  // Populated by /interviews/payments/verify on a successful signature check.
  razorpayOrderId   String?
  razorpayPaymentId String?
  amountInrPaise    Int?
  paidAt            DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, scheduledAt])
  @@index([interviewerId])
  @@index([panelist2Id])
  @@index([slotId])
  @@index([status])
}

// ---------- Interviewer portal (L4 expert interviews) ----------
// Invite-only expert interviewers. Created by a platform admin (so they're
// pre-approved); they claim open bookings from a shared pool, conduct off
// platform via the booking's meetingUrl, and score → award L4_EXPERT.
model InterviewerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String?
  bio       String?
  // Free-text expertise tags (skill / domain names) shown to help self-select
  // from the pool.
  expertise String[]
  active    Boolean  @default(true)
  // Capacity planning (Ch.6): interviews the panelist commits to per day.
  minDailyCommitment Int @default(3)
  // Periodic re-licensing (Ch.6 anti-collusion) — renewed every 2–3 months.
  licenseStatus    String    @default("active") // "active" | "pending_renewal" | "suspended"
  licenseRenewedAt DateTime?
  licenseDueAt     DateTime?
  createdAt DateTime @default(now())

  @@index([active])
  @@index([licenseStatus])
}

// A bookable interview slot. Capacity is bounded per domain/time so no single
// interviewer pool is overloaded (Ch.6 daily-slot model, reverses fixed-days).
model InterviewSlot {
  id          String   @id @default(cuid())
  startsAt    DateTime // day + start time (UTC)
  domain      String   // skill category this slot serves (domain-aware capacity)
  panelSize   Int      @default(2) // panelists required (1 or 2), per-skill (Ch.6)
  capacity    Int      @default(10) // seat cap for this domain/time
  bookedCount Int      @default(0)
  bookings    InterviewBooking[]
  createdAt   DateTime @default(now())

  @@index([startsAt])
  @@index([domain, startsAt])
}

// Fortnightly interviewer payout batch (Ch.6). Interviewers are paid regardless
// of interview outcome; amounts are near pass-through of the student fee.
model InterviewerPayout {
  id            String   @id @default(cuid())
  interviewerId String
  interviewer   User     @relation("InterviewerPayouts", fields: [interviewerId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  grossAmountPaise Int
  tdsDeductedPaise Int      @default(0) // configurable, pending CA confirmation (Ch.12)
  netAmountPaise   Int
  status        String   @default("pending") // "pending" | "paid"
  createdAt     DateTime @default(now())

  @@index([interviewerId])
  @@index([status])
}

// AI mock-interview / pre-screening attempt (Ch.7, prep-tool half). A multi-turn
// adaptive interview conducted by an LLM; the transcript, score and per-area
// feedback are stored. Free prep tool for now (not granting L4).
model AiScreenAttempt {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId       String? // SkillCatalog id (no FK; name resolved on read)
  skillName     String?
  status        String    @default("in_progress") // "in_progress" | "completed"
  transcript    Json      @default("[]") // [{ q: string, a: string | null }]
  questionCount Int       @default(0)
  score         Int? // 0–100, set on completion
  passed        Boolean?
  areaBreakdown Json? // [{ area, score, note }]
  feedback      String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt])
}

// ---------- Campus placement drives ----------
model PlacementDrive {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation("PostedDrives", fields: [postedById], references: [id], onDelete: Cascade)
  // Company portal: recruiter-posted drives link to their Employer. Null for
  // legacy / institution-posted drives.
  employerId  String?
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  company     String
  role        String
  description String?
  packageLpa  Float?
  minLevel    String   @default("L0") // "L0" | "L1_ACADEMIC" | "L2_CERTIFIED" | "L3_PROVEN" | "L4_EXPERT"
  jobType     String   @default("full_time") // "full_time" | "internship" | "contract" | "ppo"
  skills      String[]
  location    String?
  scope       String   @default("institute_only") // "institute_only" | "public"
  institutionId String?
  closesAt    DateTime?
  createdAt   DateTime @default(now())
  applications PlacementApplication[]
  recruiterInquiries RecruiterInquiry[]

  @@index([institutionId])
  @@index([jobType])
  @@index([employerId])
}

model PlacementApplication {
  id        String         @id @default(cuid())
  driveId   String
  drive     PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Pipeline stage. "applied" / "shortlisted" / "interviewing" / "offered" /
  // "hired" / "rejected".
  status    String         @default("applied")
  // How the candidate entered the pipeline: "applied" (student applied) or
  // "sourced" (recruiter pulled them in from candidate search).
  sourcedBy String         @default("applied")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt @default(now())

  @@unique([driveId, userId])
  @@index([driveId, status])
}

// ---------- Competitions (compete tab) ----------
model Competition {
  id          String   @id @default(cuid())
  title       String
  category    String   // "case" | "video_editing" | "marketing" | "debate" | "art" | "competitive_programming" | "hackathon"
  description String
  prizes      String?  // free text or JSON
  startsAt    DateTime
  endsAt      DateTime
  bannerUrl   String?
  postedById  String?
  postedBy    User?    @relation("PostedCompetitions", fields: [postedById], references: [id])
  // Institute-scoped competitions: TPO-posted ones set scope=institute_only +
  // institutionId so only that institution's students see them.
  scope         String  @default("public") // "public" | "institute_only"
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  entries     CompetitionEntry[]
  rounds      CompetitionRound[]
  judges      CompetitionJudge[]
  createdAt   DateTime @default(now())

  @@index([category, startsAt])
  @@index([institutionId])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionUrl String?
  notes         String?
  rank          Int?
  roundScores   RoundScore[]
  createdAt     DateTime    @default(now())

  @@unique([competitionId, userId])
}

// ---------- Multi-round, jury-scored competitions ----------
// A competition can have N ordered rounds. A jury panel (CompetitionJudge)
// scores each entry per round (RoundScore); the round leaderboard ranks
// entries by their average jury score, and the top `advanceCount` advance.

model CompetitionRound {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  sequence      Int // 1-based ordering within the competition
  status        String      @default("upcoming") // "upcoming" | "active" | "closed"
  advanceCount  Int? // how many top entries advance from this round (null = all/final)
  scores        RoundScore[]
  createdAt     DateTime    @default(now())

  @@unique([competitionId, sequence])
  @@index([competitionId])
}

model CompetitionJudge {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("JudgePanels", fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([competitionId, userId])
}

model RoundScore {
  id        String           @id @default(cuid())
  roundId   String
  round     CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entryId   String
  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  judgeId   String
  judge     User             @relation("JudgedScores", fields: [judgeId], references: [id], onDelete: Cascade)
  score     Int // 0..100
  feedback  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // One score per judge per entry per round (re-scoring updates in place).
  @@unique([roundId, entryId, judgeId])
  @@index([roundId])
}

// ---------- Audit log for human-reviewer / admin actions ----------
// Every admin write action (approve / reject a college-ID, hide a post,
// approve a user-suggested institution, etc.) writes one row here. Future
// disputes get investigated from this single source of truth.
//
// `targetType` + `targetId` is a polymorphic pointer — we deliberately don't
// FK to each target table because we want the audit row to survive even if
// the target is hard-deleted later (e.g. an institution rejected & removed).
model VerificationAudit {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  targetType    String   // "college_id" | "academic_record" | "institution" | "community_post" | "community_comment"
  targetId      String
  action        String   // "approve" | "reject" | "edit" | "hide" | "unhide" | "delete"
  reasonCode    String?  // from REJECTION_REASONS enum on reject actions
  reasonNote    String?
  previousState Json?    // snapshot of fields that changed (for diffing)
  createdAt     DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}

// ---------- Direct messages (1:1 chat) ----------
// Minimal Twitter-DM-style model — no read receipts beyond a readAt timestamp,
// no media, no group chats yet. Threads are implied by the (senderId,
// recipientId) pair — we query both directions when loading a conversation.
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

// ---------- Freelance marketplace ----------
model FreelanceService {
  id          String   @id @default(cuid())
  providerId  String
  provider    User     @relation("ProvidedServices", fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  category    String   // "development" | "design" | "marketing" | "data_science" | "video_editing" | "writing" | "other"
  description String
  priceFrom   Float?
  priceUnit   String?  // "hour" | "project" | "month"
  skills      String[]
  location    String?
  geoLat      Float?   // populated by the geocode helper when the user clicks "use my location"
  geoLng      Float?
  isRemote    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  inquiries   FreelanceInquiry[]

  @@index([category])
  @@index([providerId])
}

// Inquiry / order workflow: client sends a brief on a service, provider can
// accept (turns into an active order), decline, or chat via messages.
model FreelanceInquiry {
  id           String           @id @default(cuid())
  serviceId    String
  service      FreelanceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId     String
  client       User             @relation("FreelanceInquiriesAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User             @relation("FreelanceInquiriesAsProvider", fields: [providerId], references: [id], onDelete: Cascade)
  brief        String
  budgetInr    Float?
  deadlineAt   DateTime?
  status       String           @default("pending") // "pending" | "accepted" | "declined" | "completed" | "cancelled"
  providerNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     FreelanceMessage[]

  @@index([clientId, createdAt])
  @@index([providerId, createdAt])
}

model FreelanceMessage {
  id        String           @id @default(cuid())
  inquiryId String
  inquiry   FreelanceInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime         @default(now())

  @@index([inquiryId, createdAt])
}

/// Server-side idempotency cache. The interceptor records the first response
/// for a given (key, userId, route) tuple and serves the cached response on
/// any retry that arrives within `expiresAt`. Protects against the
/// double-booking / double-application class of bug when a flaky client
/// retries a POST.
///
/// The cache is scoped by user so two different students sharing a key
/// (theoretically possible if a client hardcodes one) don't collide.
model IdempotencyKey {
  key         String   @id
  userId      String
  route       String
  statusCode  Int
  responseBody Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([key, userId, route])
  @@index([expiresAt])
}

// ---------- Company / Recruiter portal ----------
// Demand side of the marketplace. Recruiters are vetted (admin-approved) before
// they can search students; contact details are gated behind student consent
// (RecruiterInquiry accept). One recruiter per company in v1.

model Employer {
  id          String   @id @default(cuid())
  name        String
  website     String?
  // Verified company email domain, when known. Optional and unique-when-set.
  domain      String?  @unique
  logoUrl     String?
  description String?
  // Org-level approval flag, set when the founding recruiter is approved.
  verified    Boolean  @default(false)
  // The founding recruiter. 1 recruiter / company in v1 (RecruiterProfile is 1:1).
  createdById String
  createdBy   User     @relation("CreatedEmployers", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  recruiter   RecruiterProfile?
  drives      PlacementDrive[]

  @@index([createdById])
}

model RecruiterProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1 recruiter per company in v1 → employer is unique to this recruiter.
  employerId  String   @unique
  employer    Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  fullName    String?  // recruiter's display name
  title       String?  // "Talent Lead", "Founder", etc.
  // "pending" | "approved" | "rejected" — gates access to candidate search.
  status      String   @default("pending")
  approvedAt  DateTime?
  rejectionReasonCode String?
  rejectionReason     String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

// Recruiter → student contact request. Mirrors FreelanceInquiry: the student
// must accept before the recruiter sees their contact details. Optionally tied
// to a specific drive for context.
model RecruiterInquiry {
  id          String   @id @default(cuid())
  recruiterId String
  recruiter   User     @relation("RecruiterInquiriesAsRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("RecruiterInquiriesAsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  driveId     String?
  drive       PlacementDrive? @relation(fields: [driveId], references: [id], onDelete: SetNull)
  message     String
  // "pending" | "accepted" | "declined". Accept reveals contact + opens a DM.
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@unique([recruiterId, studentId, driveId])
  @@index([studentId, createdAt])
  @@index([recruiterId, createdAt])
}

// ---------- Institution / TPO portal ----------
// Placement-cell admins with read-only oversight of their institution's
// students + the ability to post institute-scoped drives/competitions. Vetted
// (admin-approved). Multiple admins per institution allowed.
model InstitutionAdminProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fullName      String?
  title         String?  // "Placement Officer", "TPO", "Dean", etc.
  // "pending" | "approved" | "rejected" — gates access to the roster.
  status        String   @default("pending")
  approvedAt    DateTime?
  rejectionReason String?
  createdAt     DateTime @default(now())

  @@index([institutionId])
  @@index([status, createdAt])
}

// Recruiter's saved shortlist bookmark.
model SavedCandidate {
  id          String   @id @default(cuid())
  recruiterId String
  recruiter   User     @relation("SavedByRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("SavedAsCandidate", fields: [studentId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([recruiterId, studentId])
  @@index([recruiterId, createdAt])
}
