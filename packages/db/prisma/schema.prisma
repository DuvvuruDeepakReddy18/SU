// SkillVerify — Prisma schema
// Multi-role model included up-front so we don't need to migrate later.
// Only STUDENT-facing endpoints are wired up in Phase 1.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  STUDENT
  RECRUITER
  INSTITUTION_ADMIN
  INTERVIEWER
  PLATFORM_ADMIN
}

enum VerificationLayer {
  L0_UNVERIFIED
  L1_ACADEMIC
  L2_CERTIFIED
  L3_PROVEN
  L4_EXPERT
}

enum CertificationTier {
  TIER_1
  TIER_2
  TIER_3
  UNRANKED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          UserRole  @default(STUDENT)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile        StudentProfile?
  userSkills            UserSkill[]
  certifications        Certification[]
  projects              Project[]
  academicRecords       AcademicRecord[]
  externalIntegrations  ExternalIntegration[]
  submissions           Submission[]
  communityPosts        CommunityPost[]
  notifications         Notification[]
  votes                 CommunityVote[]
  communityComments     CommunityComment[]
  interviewBookings     InterviewBooking[]
  postedDrives          PlacementDrive[] @relation("PostedDrives")
  placementApplications PlacementApplication[]
  postedCompetitions    Competition[]    @relation("PostedCompetitions")
  competitionEntries    CompetitionEntry[]
  providedServices         FreelanceService[]  @relation("ProvidedServices")
  freelanceInquiriesAsClient   FreelanceInquiry[] @relation("FreelanceInquiriesAsClient")
  freelanceInquiriesAsProvider FreelanceInquiry[] @relation("FreelanceInquiriesAsProvider")
  freelanceMessages        FreelanceMessage[]

  @@index([institutionId])
}

model Institution {
  id            String  @id @default(cuid())
  name          String
  // Optional + unique-when-present: some institutions (small DU colleges, etc.)
  // don't have their own email domain. Signup falls back to a chosen
  // institution id from the picker instead of email-derived matching.
  domain        String? @unique
  shortName     String?  // "IIT-D", "SRCC", "IIM-A"
  category      String?  // "engineering" | "management" | "law" | "science" | "commerce" | "arts" | "medical" | "other"
  nirfRank      Int?
  state         String?
  city          String?
  // Curated rows start verified=true. User-suggested rows from the signup
  // picker land here as verified=false and surface in the admin queue.
  verified      Boolean @default(true)
  addedByUserId String?
  tier          String?
  licenseStatus String  @default("trial")
  users         User[]
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([nirfRank])
  @@index([name])
}

model StudentProfile {
  userId         String  @id
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  // Legal name as it appears on the college ID. Used for verification
  // matching; may differ from fullName (preferred name shown in UI).
  governmentName String?
  // E.164-format phone number captured at signup ("+91XXXXXXXXXX").
  phoneNumber    String?
  // Distinct from User.email (which is the login email — can be Gmail/etc).
  // This is the @college.edu address used for institutional correspondence.
  instituteEmail String?
  // e.g. "B.Tech", "MBA", "BCA", "MBBS" — drives the # of semester tiles
  // on the verification page.
  courseProgram  String?
  headline       String?
  bio            String?
  avatarUrl      String?
  resumeUrl      String?
  // Free-text CGPA — shown alongside an UNVERIFIED badge until backed by
  // at least one verified AcademicRecord (see cgpaVerifiedAt).
  cgpa           Float?
  cgpaVerifiedAt DateTime?
  graduationYear Int?
  sharableSlug   String  @unique
  phone          String?
  location       String?
  geoLat         Float?
  geoLng         Float?
  // Social / profile links — extracted by the resume parser when present.
  linkedinUrl    String?
  githubUrl      String?
  leetcodeUrl    String?
  codechefUrl    String?
  portfolioUrl   String?
  // Institutional verification artefact (College ID card upload).
  collegeIdUrl              String?
  collegeIdUploadedAt       DateTime?
  collegeIdVerifiedAt       DateTime?
  // "pending_review" | "verified" | "rejected" | null (no ID uploaded yet)
  collegeIdStatus           String?
  collegeIdRejectionReason  String?
  // Snapshot of what the OCR pre-screen extracted, for the admin queue.
  collegeIdOcrExtracted     Json?
  // User-defined "custom" links beyond the built-in social ones.
  // Shape: [{ label: string, url: string, icon?: string }]
  customLinks    Json?
  isPublic       Boolean @default(true)
  // Public-portfolio customization. Controls the rendered theme and the
  // order of sections on /u/[slug]. Defaults give the existing layout.
  shareTheme        String   @default("default") // "default" | "midnight" | "minimal"
  shareSectionsOrder String[] @default(["about", "skills", "projects", "certifications"])
  updatedAt      DateTime @updatedAt
}

model SkillCatalog {
  id             String          @id @default(cuid())
  name           String          @unique
  category       String
  parentSkillId  String?
  parent         SkillCatalog?   @relation("Children", fields: [parentSkillId], references: [id])
  children       SkillCatalog[]  @relation("Children")
  userSkills     UserSkill[]
  certifications Certification[]
  tierRules      CertificationTierRule[]

  @@index([category])
}

model UserSkill {
  id                       String            @id @default(cuid())
  userId                   String
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId                  String
  skill                    SkillCatalog      @relation(fields: [skillId], references: [id])
  selfRatedLevel           Int               @default(1)
  highestVerificationLayer VerificationLayer @default(L0_UNVERIFIED)
  createdAt                DateTime          @default(now())

  @@unique([userId, skillId])
  @@index([skillId])
}

model Certification {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId            String?
  skill              SkillCatalog?     @relation(fields: [skillId], references: [id])
  issuer             String
  courseName         String
  issuedAt           DateTime?
  certificateUrl     String?
  verificationUrl    String?
  tier               CertificationTier @default(UNRANKED)
  verificationStatus String            @default("pending")
  createdAt          DateTime          @default(now())

  @@index([userId])
}

model CertificationTierRule {
  id         String            @id @default(cuid())
  issuer     String
  courseName String
  skillId    String?
  skill      SkillCatalog?     @relation(fields: [skillId], references: [id])
  tier       CertificationTier

  @@unique([issuer, courseName])
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String   // "github" | "manual"
  title        String
  description  String?
  repoUrl      String?
  liveUrl      String?
  techStack    String[]
  stars        Int      @default(0)
  lastCommitAt DateTime?
  linkedSkills String[]
  createdAt    DateTime @default(now())

  @@index([userId])
}

model AcademicRecord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    Int
  cgpa        Float
  sgpa        Float?
  docUrl      String?
  // OCR-extracted from the uploaded marksheet. Used to display "verified by
  // <name>" and to support audits.
  extractedName        String?
  extractedInstitution String?
  examDate             DateTime?
  // SHA-256 of the uploaded file — used to reject exact-duplicate marksheets
  // (same student reuploading; different students submitting the same image).
  fileSha256           String?
  // "pending" | "verified" | "rejected"
  verificationStatus   String   @default("pending")
  // Raw OCR output for the admin queue / audit log.
  ocrExtracted         Json?
  rejectionReason      String?
  verifiedVia String    // "digilocker" | "institution" | "manual" | "ai_ocr"
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([fileSha256])
}

model ExternalIntegration {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String   // "github" | "linkedin" | "leetcode" | "coursera"
  providerUserId        String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  lastSyncedAt          DateTime?
  syncStatus            String   @default("idle")
  createdAt             DateTime @default(now())

  @@unique([userId, provider])
}

model Problem {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  difficulty   String           // "easy" | "medium" | "hard"
  topics       String[]
  description  String
  constraints  String?
  examplesJson Json
  starterCode  Json?            // { python, javascript, cpp, java }
  points       Int              @default(10)
  testCases    TestCase[]
  submissions  Submission[]
  domains      PracticeDomain[] @relation("DomainProblems")
  createdAt    DateTime         @default(now())
}

model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  output    String
  isHidden  Boolean @default(true)
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id])
  language    String
  code        String
  verdict     String   // "AC" | "WA" | "TLE" | "RE" | "CE" | "PENDING"
  runtimeMs   Int?
  memoryKb    Int?
  aiFeedback  Json?
  // For non-AC verdicts we capture the first failing test case + its diff so
  // the student can see what their code actually printed vs what was expected.
  failedTest  Json?   // { input, expectedOutput, gotStdout, stderr, compileOutput }
  testsPassed Int?
  testsTotal  Int?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([problemId])
}

model CommunityPost {
  id          String             @id @default(cuid())
  authorId    String
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAnonymous Boolean            @default(false)
  // Optional title — Reddit-style. Null means it's a quick microblog post.
  title       String?
  body        String
  tags        String[]
  // Sub-community slug — "general" | "internships" | "placements" | "freelance"
  // | "academic" | "rant" | "ama" | etc. Free-form but UI suggests defaults.
  subreddit   String             @default("general")
  visibility  String             @default("public") // "public" | "college_only"
  upvotes     Int                @default(0)
  downvotes   Int                @default(0)
  // "Score" = upvotes - downvotes. Maintained transactionally on vote
  // toggles so sort=top/hot doesn't need a heavy aggregate query.
  score       Int                @default(0)
  commentsCount Int              @default(0)
  // Moderator soft-delete. The post stays in the DB for audit, but the
  // body is replaced with "[removed]" in the UI.
  hiddenByMod Boolean            @default(false)
  createdAt   DateTime           @default(now())
  votes       CommunityVote[]
  comments    CommunityComment[]

  @@index([createdAt])
  @@index([subreddit, score])
  @@index([score])
}

// Renamed conceptually to "like" but model kept as CommunityVote for back-compat.
// value is now always 1 (we removed downvotes from the UI).
model CommunityVote {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int           // 1 (like) — old data may have -1, ignored by new UI
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model CommunityComment {
  id          String        @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAnonymous Boolean       @default(false)
  body        String
  // Threading: a null parent means top-level. Self-relation explicitly
  // names the back-relation so Prisma stops being ambiguous.
  parentCommentId String?
  parent          CommunityComment?  @relation("Replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         CommunityComment[] @relation("Replies")
  // Moderator soft-delete (same idea as posts).
  hiddenByMod Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
  @@index([parentCommentId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  userId     String
  scope      String   // "global" | "college:<id>" | "skill:<id>"
  score      Int
  rank       Int
  computedAt DateTime @default(now())

  @@index([scope, rank])
  @@index([userId, scope])
}

// ---------- Practice domains (Algorithms, Python, SQL, ...) ----------
model PracticeDomain {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?   // lucide icon name
  sortOrder   Int       @default(0)
  problems    Problem[] @relation("DomainProblems")
}

// Optional domain link on Problem (added without breaking existing relations).
// Defined via the relation above; Problem's side is a many-to-many through
// implicit table, since one problem can belong to multiple domains
// (e.g. Two Sum → Algorithms + Data Structures + Python).

// ---------- L4 Expert Interview bookings ----------
model InterviewBooking {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String?
  scheduledAt DateTime
  status      String   @default("scheduled") // "scheduled" | "passed" | "failed" | "cancelled" | "no_show"
  notes       String?
  panelNotes  String?
  result      String?  // "L4_VERIFIED" | "FEEDBACK_ONLY"
  meetingUrl  String?  // auto-generated Jitsi room URL
  // Razorpay payment fields — null when the platform is in free-beta mode.
  // Populated by /interviews/payments/verify on a successful signature check.
  razorpayOrderId   String?
  razorpayPaymentId String?
  amountInrPaise    Int?
  paidAt            DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, scheduledAt])
}

// ---------- Campus placement drives ----------
model PlacementDrive {
  id          String   @id @default(cuid())
  postedById  String
  postedBy    User     @relation("PostedDrives", fields: [postedById], references: [id], onDelete: Cascade)
  company     String
  role        String
  description String?
  packageLpa  Float?
  minLevel    String   @default("L0") // "L0" | "L1_ACADEMIC" | "L2_CERTIFIED" | "L3_PROVEN" | "L4_EXPERT"
  jobType     String   @default("full_time") // "full_time" | "internship" | "contract" | "ppo"
  skills      String[]
  location    String?
  scope       String   @default("institute_only") // "institute_only" | "public"
  institutionId String?
  closesAt    DateTime?
  createdAt   DateTime @default(now())
  applications PlacementApplication[]

  @@index([institutionId])
  @@index([jobType])
}

model PlacementApplication {
  id        String         @id @default(cuid())
  driveId   String
  drive     PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String         @default("applied") // "applied" | "shortlisted" | "rejected" | "hired"
  createdAt DateTime       @default(now())

  @@unique([driveId, userId])
}

// ---------- Competitions (compete tab) ----------
model Competition {
  id          String   @id @default(cuid())
  title       String
  category    String   // "case" | "video_editing" | "marketing" | "debate" | "art" | "competitive_programming" | "hackathon"
  description String
  prizes      String?  // free text or JSON
  startsAt    DateTime
  endsAt      DateTime
  bannerUrl   String?
  postedById  String?
  postedBy    User?    @relation("PostedCompetitions", fields: [postedById], references: [id])
  entries     CompetitionEntry[]
  createdAt   DateTime @default(now())

  @@index([category, startsAt])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionUrl String?
  notes         String?
  rank          Int?
  createdAt     DateTime    @default(now())

  @@unique([competitionId, userId])
}

// ---------- Freelance marketplace ----------
model FreelanceService {
  id          String   @id @default(cuid())
  providerId  String
  provider    User     @relation("ProvidedServices", fields: [providerId], references: [id], onDelete: Cascade)
  title       String
  category    String   // "development" | "design" | "marketing" | "data_science" | "video_editing" | "writing" | "other"
  description String
  priceFrom   Float?
  priceUnit   String?  // "hour" | "project" | "month"
  skills      String[]
  location    String?
  geoLat      Float?   // populated by the geocode helper when the user clicks "use my location"
  geoLng      Float?
  isRemote    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  inquiries   FreelanceInquiry[]

  @@index([category])
  @@index([providerId])
}

// Inquiry / order workflow: client sends a brief on a service, provider can
// accept (turns into an active order), decline, or chat via messages.
model FreelanceInquiry {
  id           String           @id @default(cuid())
  serviceId    String
  service      FreelanceService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  clientId     String
  client       User             @relation("FreelanceInquiriesAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  providerId   String
  provider     User             @relation("FreelanceInquiriesAsProvider", fields: [providerId], references: [id], onDelete: Cascade)
  brief        String
  budgetInr    Float?
  deadlineAt   DateTime?
  status       String           @default("pending") // "pending" | "accepted" | "declined" | "completed" | "cancelled"
  providerNote String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     FreelanceMessage[]

  @@index([clientId, createdAt])
  @@index([providerId, createdAt])
}

model FreelanceMessage {
  id        String           @id @default(cuid())
  inquiryId String
  inquiry   FreelanceInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime         @default(now())

  @@index([inquiryId, createdAt])
}
